{
  "name": "understudy",
  "version": "1.0.0",
  "description": "",
  "directories": {
    "doc": "docs"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "test": "vitest run",
    "dev": "next dev examples/app",
    "build": "next build examples/app",
    "start": "next start examples/app",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "bash scripts/check.sh",
    "db:generate": "npm exec --workspace @understudy/engine -- drizzle-kit generate && npm exec --workspace @understudy/example-app -- drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=examples/app/.env.local examples/app/scripts/migrate.mjs",
    "db:seed": "tsx --env-file-if-exists=examples/app/.env.local examples/app/db/seed.ts",
    "persona:load": "tsx --env-file-if-exists=examples/app/.env.local examples/app/scripts/persona/load.ts",
    "metrics:report": "tsx --env-file-if-exists=examples/app/.env.local examples/app/scripts/metrics-report.ts",
    "eval:retrieval": "tsx --env-file-if-exists=examples/app/.env.local examples/app/scripts/persona/eval-retrieval.ts",
    "persona:publish": "tsx --env-file-if-exists=examples/app/.env.local examples/app/scripts/persona/publish-card.ts",
    "eval:engine": "tsx --env-file-if-exists=examples/app/.env.local examples/app/scripts/eval-engine.ts",
    "eval:persona": "tsx --env-file-if-exists=examples/app/.env.local examples/app/scripts/persona/eval-persona.ts",
    "persona:build": "node --env-file-if-exists=examples/app/.env.local packages/persona/src/cli.mjs build",
    "persona:synth": "node --env-file-if-exists=examples/app/.env.local packages/persona/src/cli.mjs synth",
    "persona:scrape": "node --env-file-if-exists=examples/app/.env.local packages/persona/src/cli.mjs scrape",
    "persona:leak": "node --env-file-if-exists=examples/app/.env.local packages/persona/src/cli.mjs leak-check",
    "check:env": "node examples/app/scripts/check-env.mjs",
    "test:live": "LIVE=1 vitest run --config vitest.live.config.mts",
    "sim": "tsx --env-file-if-exists=examples/app/.env.local examples/app/scripts/sim/run.ts",
    "sim:load-lines": "tsx --env-file-if-exists=examples/app/.env.local examples/app/scripts/sim/load-lines.ts",
    "sim:review": "tsx --env-file-if-exists=examples/app/.env.local examples/app/scripts/sim/review.ts",
    "server:dev": "npm run dev --workspace @understudy/example-server",
    "server:demo": "npm run demo --workspace @understudy/example-server --"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
