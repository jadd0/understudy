{
  "name": "understudy",
  "version": "1.0.0",
  "description": "",
  "directories": {
    "doc": "docs"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "npm exec --workspace @understudy/engine -- drizzle-kit generate && drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "tsx --env-file-if-exists=.env.local db/seed.ts",
    "persona:load": "tsx --env-file-if-exists=.env.local scripts/persona/load.ts",
    "metrics:report": "tsx --env-file-if-exists=.env.local scripts/metrics-report.ts",
    "eval:retrieval": "tsx --env-file-if-exists=.env.local scripts/persona/eval-retrieval.ts",
    "persona:publish": "tsx --env-file-if-exists=.env.local scripts/persona/publish-card.ts",
    "eval:engine": "tsx --env-file-if-exists=.env.local scripts/eval-engine.ts",
    "eval:persona": "understudy-persona eval",
    "persona:build": "understudy-persona build",
    "persona:synth": "understudy-persona synth",
    "persona:scrape": "understudy-persona scrape",
    "persona:leak": "understudy-persona leak-check",
    "check:env": "node scripts/check-env.mjs",
    "test:live": "LIVE=1 vitest run --config vitest.live.config.mts",
    "sim": "tsx --env-file-if-exists=.env.local scripts/sim/run.ts",
    "sim:load-lines": "tsx --env-file-if-exists=.env.local scripts/sim/load-lines.ts",
    "sim:review": "tsx --env-file-if-exists=.env.local scripts/sim/review.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@auth/drizzle-adapter": "^1.11.3",
    "@neondatabase/serverless": "^1.2.0",
    "@understudy/engine": "*",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.4",
    "next-auth": "^5.0.0-beta.32",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.1.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
