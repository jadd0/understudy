{
  "name": "@jadd0/understudy-example-app",
  "version": "0.1.0",
  "description": "A Next.js host for the Understudy engine: fan chat, creator console, wallet, Stripe and Pusher, on the packages.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": { "understudy": "scripts/understudy.mjs" },
  "scripts": {
    "dev": "npm run --prefix ../.. build:packages && next dev",
    "build": "npm run --prefix ../.. build:packages && next build",
    "start": "next start"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@neondatabase/serverless": "^1.2.0",
    "@jadd0/understudy-engine": "*",
    "@jadd0/understudy-providers": "*",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.4",
    "next-auth": "^5.0.0-beta.32",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.1.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "tailwindcss": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
