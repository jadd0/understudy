# Copy to .env.local for local work; set the same names in Vercel for production (docs/operations/DEPLOY.md).
# Names only: never commit a real value. `npm run check:env` checks a file against lib/env.
# Uncommented keys are required by lib/env. Commented keys are optional locally (lib/env rejects an
# empty value, so leave the line commented or fill it) and `npm run check:env -- <file> --production`
# requires them for a deploy.

# --- Database (required) ---
# Neon connection string. Production uses its own Neon branch, never the dev database.
DATABASE_URL=

# --- Auth.js (required: AUTH_SECRET; AUTH_URL is needed in production) ---
# Random string, e.g. `openssl rand -base64 32`. Different per environment.
AUTH_SECRET=
# Public origin of the app, no trailing slash: http://localhost:3000 locally, https://<domain> in production.
# AUTH_URL=

# --- Sign-in email via Resend (required) ---
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. Juno <hello@example.com>.
EMAIL_FROM=

# --- Cloudflare Turnstile (required) ---
# The site key is public (sent to the browser); the production hostname must be added to the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Model providers (optional locally, required in production) ---
# CLAUDE_SECRET_KEY=
# TYPESAFE_SECRET_KEY=
# VOYAGE_API_KEY=

# --- Stripe (optional locally, required in production) ---
# Test-mode secret key (sk_test_...) and the signing secret (whsec_...) of the webhook endpoint
# https://<domain>/api/webhooks/stripe. Locally, `stripe listen` prints its own whsec_.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Pusher Channels (optional locally, required in production) ---
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=
# Browser copies of PUSHER_KEY and PUSHER_CLUSTER; they must hold the same values.
# NEXT_PUBLIC_PUSHER_KEY=
# NEXT_PUBLIC_PUSHER_CLUSTER=

# --- Vercel Cron (production only; read by /api/cron/sweep, not by lib/env) ---
# Random string. Vercel sends it as `Authorization: Bearer <value>`; without it the route answers 401.
# CRON_SECRET=

# --- Seed and demo seats (optional) ---
# Creator seat (Juno) and comma-separated admin seats, created by `npm run db:seed`.
# SEED_CREATOR_EMAIL=
# SEED_ADMIN_EMAILS=
# Shared password for those seats; without it the seats cannot sign in.
# DEMO_SEAT_PASSWORD=

# --- Leak check (optional; gate step `leak`) ---
# Absolute path of a private raw scrape (one folder per handle). When set, the gate fails if any of its
# text or handles appears in the tree. Unset, the step is skipped.
# LEAK_CHECK_RAW=
