# Environment for the headless server (examples/server). Names only: never commit a real value.
# Run with `docker run -e NAME=value ...` or `node --env-file=.env`.

# ===== Required =====

# Postgres with the pgvector extension.
DATABASE_URL=
# The key callers send as a bearer token. Any long random string.
UNDERSTUDY_API_KEY=
# Anthropic key: drafts every reply and decides when Jev is off.
CLAUDE_SECRET_KEY=

# ===== Optional =====

# Jev decides first when set — without it: Claude decides alone.
# TYPESAFE_SECRET_KEY=
# Signed webhook for human-takeover events — without it: no webhook is sent. Both or neither.
# WEBHOOK_URL=
# WEBHOOK_SECRET=
# Port (default 8787) and address (default 127.0.0.1; the container image sets HOST=0.0.0.0).
# PORT=
# HOST=
