      "statement": "select coalesce((select no_pitch_until > now() from conversations where id = $1), false) as no_pitch_active, (select count(*)::int from offers where conversation_id = $2 and status = 'declined' and resolved_at > now() - make_interval(mins => $3::int)) as declines, (select count(*)::int from turns t where t.conversation_id = $4 and t.outcome = 'replied' and t.offer_id is null and cardinality(t.inbound_ids) > 0 and t.created_at > coalesce((select max(created_at) from offers where conversation_id = $5), 'epoch'::timestamptz)) as since_offer, coalesce((select hold_suppressed_until > now() from conversations where id = $6), false) as hold_suppressed, exists(select 1 from handoffs where conversation_id = $7 and status <> 'resolved') as unresolved, exists(select 1 from offers where conversation_id = $8 and status = 'open' and expires_at > now()) as open_offer, exists(select 1 from offers where conversation_id = $9 and status = 'accepted') as unlocked, exists( select 1 from offers o where o.conversation_id = $10 and o.status = 'accepted' and o.resolved_at > coalesce( (select max(m.created_at) from messages m where m.conversation_id = $11 and m.sender in ('ai', 'creator', 'admin') and m.status = 'sent'), '-infinity'::timestamptz) ) as just_unlocked",
