{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Instagram Scraper Data Flow",
    "quality_profile": "standard",
    "viewBox": [
      1100,
      420
    ]
  },
  "stages": [
    {
      "label": "Source"
    },
    {
      "label": "Transport"
    },
    {
      "label": "Collect"
    },
    {
      "label": "Raw layout"
    },
    {
      "label": "Existing pipeline"
    }
  ],
  "nodes": [
    {
      "id": "instagram",
      "type": "external",
      "label": "Instagram web API",
      "sublabel": "your own account",
